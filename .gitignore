# Root gitignore for haber-sitesi monorepo

# Dependencies
/frontend/node_modules/
/backend/vendor/

# Next.js Build Output
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/.vercel/

# Environment Files (Keep .env.example)
/frontend/.env*
!/frontend/.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example

# Laravel Runtime & Storage
/backend/storage/*.key
/backend/storage/logs/*.log
/backend/storage/framework/cache/data/*
!/backend/storage/framework/cache/data/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/.phpunit.result.cache

# Misc & OS Files
.DS_Store
Thumbs.db
*.log
*.tsbuildinfo
next-env.d.ts
